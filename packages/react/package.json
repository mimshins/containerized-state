{
  "name": "react-containerized-state",
  "version": "3.3.1",
  "description": "Fast and minimal state container which can be used and shared across React or non-React components.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "keywords": [
    "react",
    "state",
    "state management",
    "fast",
    "minimal",
    "containerized"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mimshins/containerized-state.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/mimshins/containerized-state/issues"
  },
  "author": {
    "name": "Mostafa Shamsitabar",
    "email": "mostafa.sh.coderino@gmail.com"
  },
  "license": "MIT",
  "peerDependencies": {
    "react": ">=16.8"
  },
  "dependencies": {
    "containerized-state": "workspace:*",
    "use-sync-external-store": "^1.6.0"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/use-sync-external-store": "1.7.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  }
}
