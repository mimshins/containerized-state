{
  "name": "containerized-state-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mimshins/containerized-state.git"
  },
  "bugs": {
    "url": "https://github.com/mimshins/containerized-state/issues"
  },
  "scripts": {
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm test:tools && pnpm check:packages",
    "build": "pnpm -r run build",
    "lint": "oxlint -c .oxlintrc.json --type-aware",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "typecheck": "pnpm -r run typecheck && tsc -p tsconfig.json",
    "test": "pnpm -r run test",
    "test:watch": "pnpm -r --parallel run test:watch",
    "test:tools": "vitest run",
    "check:packages": "pnpm build && tsx tools/check-packages.ts",
    "changeset": "changeset",
    "changeset:status": "changeset status --since=origin/main",
    "clean": "find . \\( -name dist -o -name coverage -o -name '*.tsbuildinfo' \\) -not -path '*/node_modules/*' -prune -exec rm -rf {} +"
  },
  "devDependencies": {
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "3.0.3",
    "@types/node": "26.6.5",
    "@vitest/coverage-v8": "5.0.5",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "tsdown": "0.23.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=24.20.0"
  },
  "packageManager": "pnpm@12.16.0+sha512.e9ccc91a0b8d52da297c16841f9ee05f3ddd631bd757ef26a211687d4a38de653c614453649294438c58be74c2ba62d53e633a4e153708c012296d0f3ee27b36"
}
