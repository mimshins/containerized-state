{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "import",
    "oxc",
    "unicorn",
    "promise",
    "node",
    "vitest",
    "react"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "pedantic": "error",
    "perf": "error"
  },
  "options": {
    "denyWarnings": true,
    "reportUnusedDisableDirectives": "error"
  },
  "ignorePatterns": [
    "**/dist/**",
    "**/coverage/**",
    "**/node_modules/**",
    "tools/published-types/**"
  ],
  "rules": {
    "typescript/no-explicit-any": "error",
    "typescript/ban-ts-comment": [
      "error",
      {
        "ts-expect-error": "allow-with-description",
        "ts-ignore": true,
        "ts-nocheck": true,
        "minimumDescriptionLength": 10
      }
    ],
    "eslint/no-eval": "error",
    "eslint/no-new-func": "error",
    "eslint/no-implied-eval": "error",
    "eslint/eqeqeq": ["error", "smart"],
    "eslint/no-var": "error",
    "eslint/prefer-const": "error",
    "import/no-cycle": "error",
    "eslint/max-lines-per-function": "off",
    "eslint/default-case": "error",
    "eslint/object-shorthand": "error",
    "eslint/no-promise-executor-return": "error",
    "eslint/no-unmodified-loop-condition": "error",
    "eslint/no-alert": "error",
    "eslint/no-duplicate-imports": [
      "error",
      {
        "includeExports": true
      }
    ],
    "eslint/no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_"
      }
    ],
    "import/extensions": [
      "error",
      "always",
      {
        "ignorePackages": true,
        "checkTypeImports": true,
        "ts": true,
        "tsx": true,
        "json": true
      }
    ],
    "import/no-unassigned-import": "error",
    "typescript/consistent-type-imports": [
      "error",
      {
        "fixStyle": "inline-type-imports"
      }
    ],
    "typescript/no-import-type-side-effects": "error",
    "typescript/no-non-null-assertion": "error",
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "typescript/await-thenable": "error",
    "vitest/no-focused-tests": "error",
    "vitest/no-disabled-tests": "error",
    "typescript/consistent-type-definitions": ["error", "type"],
    "func-style": [
      "error",
      "expression",
      {
        "allowArrowFunctions": true
      }
    ],
    "prefer-arrow-callback": [
      "error",
      {
        "allowNamedFunctions": false
      }
    ],
    "react/jsx-key": "error",
    "typescript/prefer-readonly-parameter-types": "off",
    "eslint/no-underscore-dangle": "off",
    "react/react-in-jsx-scope": "off",
    "react/jsx-no-useless-fragment": [
      "error",
      {
        "allowExpressions": true
      }
    ],
    "vitest/require-mock-type-parameters": "off"
  },
  "overrides": [
    {
      "files": ["packages/core/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "react-containerized-state",
                  "react-containerized-state/**",
                  "containerized-state-plugin-persistence",
                  "containerized-state-plugin-persistence/**",
                  "react",
                  "react/**",
                  "react-dom",
                  "react-dom/**",
                  "use-sync-external-store",
                  "use-sync-external-store/**"
                ],
                "message": "dependency direction: core <- react, core <- with-persistence; react and with-persistence never import each other (AGENTS.md)"
              },
              {
                "group": [
                  "containerized-state/**",
                  "react-containerized-state/**",
                  "containerized-state-plugin-persistence/**"
                ],
                "message": "public entry points only (AGENTS.md)"
              },
              {
                "regex": "^(\\.\\./)+(core|react|with-persistence|packages)(/|$)",
                "message": "no relative import into another package (AGENTS.md)"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/react/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "containerized-state-plugin-persistence",
                  "containerized-state-plugin-persistence/**"
                ],
                "message": "dependency direction: core <- react, core <- with-persistence; react and with-persistence never import each other (AGENTS.md)"
              },
              {
                "group": [
                  "containerized-state/**",
                  "react-containerized-state/**",
                  "containerized-state-plugin-persistence/**"
                ],
                "message": "public entry points only (AGENTS.md)"
              },
              {
                "regex": "^(\\.\\./)+(core|react|with-persistence|packages)(/|$)",
                "message": "no relative import into another package (AGENTS.md)"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/with-persistence/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "react-containerized-state",
                  "react-containerized-state/**",
                  "react",
                  "react/**",
                  "react-dom",
                  "react-dom/**",
                  "use-sync-external-store",
                  "use-sync-external-store/**"
                ],
                "message": "dependency direction: core <- react, core <- with-persistence; react and with-persistence never import each other (AGENTS.md)"
              },
              {
                "group": [
                  "containerized-state/**",
                  "react-containerized-state/**",
                  "containerized-state-plugin-persistence/**"
                ],
                "message": "public entry points only (AGENTS.md)"
              },
              {
                "regex": "^(\\.\\./)+(core|react|with-persistence|packages)(/|$)",
                "message": "no relative import into another package (AGENTS.md)"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/*/src/**"],
      "rules": {
        "import/no-default-export": "error",
        "eslint/no-console": "error"
      }
    },
    {
      "files": ["packages/*/src/index.ts"],
      "rules": {
        "eslint/no-duplicate-imports": [
          "error",
          {
            "includeExports": false
          }
        ]
      }
    },
    {
      "files": ["**/*.test.ts", "**/*.test.tsx", "tools/**"],
      "rules": {
        "eslint/max-lines": "off",
        "typescript/no-unsafe-type-assertion": "off",
        "unicorn/consistent-function-scoping": "off",
        "vitest/no-conditional-in-test": "off"
      }
    }
  ]
}
